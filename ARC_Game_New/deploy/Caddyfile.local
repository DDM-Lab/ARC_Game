# ARC Game — LOCAL WebGL test (Caddy v2, HTTP only, no TLS)
#
# Serves the WebGL client + proxies the router at the SAME ORIGIN on :8080,
# so the browser launcher derives ws://localhost:8080/ws automatically.
#
# Usage (run from the project root so the relative root path resolves):
#   ./run_router.sh                      # router on :9876
#   caddy run --config deploy/Caddyfile.local
#   open http://localhost:8080
#
# This mirrors deploy/Caddyfile (the production one); the only difference is
# the site address (:8080 vs a real domain) — so a passing local test means
# the Janus setup is just a hostname swap away.

:8080 {
	encode gzip

	@router path /ws /configs /health
	reverse_proxy @router localhost:9876

	root * Build/Client/WebGL
	file_server
}
