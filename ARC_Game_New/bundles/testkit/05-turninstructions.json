{
  "manifest": {
    "name": "testkit/05-turninstructions",
    "author": "cpulling",
    "version": "1.0.0",
    "cora_api_version": "1.0",
    "description": "per-turn authored strings replaced"
  },
  "turn_instructions": {
    "preamble": "=== FIELD SITREP ===",
    "actions_header": "=== AUTHORIZED OPERATIONS ===",
    "default": "Choose at most ONE operation, then call finish.",
    "first_brief": "Report in as {title}. One line only.",
    "addressed": "The Director addressed you. Answer them FIRST, then act."
  },
  "config": {
    "agent_order_rule": "sequential",
    "agents": [
      {
        "subagent_name": "Player",
        "role": "director",
        "actor_type": "manual"
      },
      {
        "subagent_name": "Food Mass Care Officer",
        "role": "subagent",
        "actor_type": "continuous",
        "provider": "anthropic-ddmlab",
        "llm_model": "claude-sonnet-5",
        "talkinghead_endpoint": "FoodMassCare",
        "subaction_space": [
          {
            "category": "task_choice",
            "group": "food"
          },
          {
            "category": "construction",
            "building_types": [
              "kitchen"
            ]
          },
          {
            "category": "resource_transfer"
          }
        ],
        "subobservation_space": [
          "sessionInfo",
          "satisfactionAndBudget",
          "tasks:food",
          "logistics"
        ],
        "system_prompt": "You are the Food Mass Care Officer. Be brief and concrete.",
        "opening_mode": "emergent"
      }
    ]
  }
}
