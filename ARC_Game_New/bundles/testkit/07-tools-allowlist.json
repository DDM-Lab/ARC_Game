{
  "manifest": {
    "name": "testkit/07-tools-allowlist",
    "author": "cpulling",
    "version": "1.0.0",
    "cora_api_version": "1.0",
    "description": "narrowed tool palette: advisory-only officer"
  },
  "config": {
    "agent_order_rule": "sequential",
    "agents": [
      {
        "subagent_name": "Player",
        "role": "director",
        "actor_type": "manual"
      },
      {
        "subagent_name": "Food Mass Care Officer",
        "role": "subagent",
        "actor_type": "continuous",
        "provider": "anthropic-ddmlab",
        "llm_model": "claude-sonnet-5",
        "talkinghead_endpoint": "FoodMassCare",
        "subaction_space": [
          {
            "category": "task_choice",
            "group": "food"
          },
          {
            "category": "construction",
            "building_types": [
              "kitchen"
            ]
          },
          {
            "category": "resource_transfer"
          }
        ],
        "subobservation_space": [
          "sessionInfo",
          "satisfactionAndBudget",
          "tasks:food",
          "logistics"
        ],
        "system_prompt": "You are an ADVISOR. You cannot act; you can only report and recommend.",
        "opening_mode": "emergent",
        "tools": [
          "read_state",
          "get_facilities",
          "get_tasks",
          "talk_to_director",
          "finish"
        ]
      }
    ]
  }
}
